# Copy to .env (gitignored). Never paste these anywhere else.
ESPN_LEAGUE_ID=replace_me
ESPN_SEASON=2026
# Private leagues only. Chrome > F12 > Application > Cookies > https://fantasy.espn.com
# SWID keeps its curly braces. espn_s2 is long; copy the whole value.
ESPN_SWID={XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX}
ESPN_S2=replace_me
# Booth. One OpenAI key covers both writing and voices. Anthropic and ElevenLabs win if set.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5
# OPENAI_VOICE_PLAY=onyx
# OPENAI_VOICE_COLOUR=ash
